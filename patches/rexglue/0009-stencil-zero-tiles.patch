+  // Whether the depth / stencil data in EDRAM tiles may have a nonzero stencil (see
+  // stencil_may_be_nonzero_tiles_).
+  void SetStencilTilesMayBeNonzero(uint32_t start_tiles, uint32_t end_tiles) {
+    for (uint32_t i = start_tiles; i < end_tiles; ++i) {
+      stencil_may_be_nonzero_tiles_.set(i & (xenos::kEdramTileCount - 1));
+    }
+  }
+  bool AreStencilTilesZero(uint32_t start_tiles, uint32_t end_tiles) const {
+    for (uint32_t i = start_tiles; i < end_tiles; ++i) {
+      if (stencil_may_be_nonzero_tiles_.test(i & (xenos::kEdramTileCount - 1))) {
+        return false;
+      }
+    }
+    return true;
+  }
   RenderTarget* const* last_update_accumulated_render_targets() const {
     assert_true(GetPath() == Path::kHostRenderTargets);
     return last_update_accumulated_render_targets_;
