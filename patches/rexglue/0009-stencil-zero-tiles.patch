+  // Starting from zero, only keep, zero, clamped decrement and replace with a reference that is
+  // zero in the written bits keep the stencil zero.
+  if ((depth_and_color_rts_used_bits & 1) && normalized_depth_control.stencil_enable) {
+    auto may_write_nonzero = [](xenos::StencilOp op, reg::RB_STENCILREFMASK ref_mask) {
