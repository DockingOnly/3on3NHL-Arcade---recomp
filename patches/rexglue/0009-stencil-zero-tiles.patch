 }
 
+void RenderTargetCache::UpdateStencilZeroTilesForDraw(reg::RB_DEPTHCONTROL normalized_depth_control,
+                                                      const Shader& vertex_shader,
+                                                      bool pixels_may_be_discarded) {
+  if (GetPath() != Path::kHostRenderTargets || !last_update_used_render_targets_[0] ||
+      pixels_may_be_discarded || !normalized_depth_control.stencil_enable) {
+    return;
+  }
+  const RegisterFile& regs = register_file();
+  // Every sample must pass the stencil and the depth test (or have it disabled), and the pass
+  // operation must write zero to all 8 bits, for both faces.
+  auto writes_zero = [](xenos::CompareFunction stencil_func, xenos::StencilOp zpass_op,
+                        reg::RB_STENCILREFMASK ref_mask) {
+    return stencil_func == xenos::CompareFunction::kAlways &&
+           ref_mask.stencilwritemask == 0xFF &&
+           (zpass_op == xenos::StencilOp::kZero ||
+            (zpass_op == xenos::StencilOp::kReplace && !ref_mask.stencilref));
+  };
+  if (normalized_depth_control.z_enable &&
+      normalized_depth_control.zfunc != xenos::CompareFunction::kAlways) {
+    return;
+  }
+  if (!writes_zero(normalized_depth_control.stencilfunc, normalized_depth_control.stencilzpass,
+                   regs.Get<reg::RB_STENCILREFMASK>())) {
+    return;
+  }
+  if (normalized_depth_control.backface_enable) {
+    reg::RB_STENCILREFMASK ref_mask_bf;
+    ref_mask_bf.value = regs.values[XE_GPU_REG_RB_STENCILREFMASK_BF];
+    if (!writes_zero(normalized_depth_control.stencilfunc_bf,
+                     normalized_depth_control.stencilzpass_bf, ref_mask_bf)) {
+      return;
+    }
+  }
+  auto rb_colorcontrol = regs.Get<reg::RB_COLORCONTROL>();
+  if ((rb_colorcontrol.alpha_test_enable &&
+       rb_colorcontrol.alpha_func != xenos::CompareFunction::kAlways) ||
+      rb_colorcontrol.alpha_to_mask_enable) {
+    return;
+  }
+  // The sample mask has 4 bits (samples) for each pixel of a 2x2 quad.
+  if ((regs[XE_GPU_REG_PA_SC_AA_MASK] & 0xFFFF) != 0xFFFF) {
+    return;
+  }
+  int32_t left, top, right, bottom;
+  if (!draw_extent_estimator_.EstimateCoveredRectangle(vertex_shader, left, top, right, bottom)) {
+    return;
+  }
+  // Whole tiles covered, in samples.
+  RenderTargetKey depth_key = last_update_used_render_targets_[0]->key();
+  uint32_t pitch_tiles = depth_key.GetPitchTiles();
+  int32_t left_samples = left << uint32_t(depth_key.msaa_samples >= xenos::MsaaSamples::k4X);
+  int32_t right_samples = right << uint32_t(depth_key.msaa_samples >= xenos::MsaaSamples::k4X);
+  int32_t top_samples = top << uint32_t(depth_key.msaa_samples >= xenos::MsaaSamples::k2X);
+  int32_t bottom_samples = bottom << uint32_t(depth_key.msaa_samples >= xenos::MsaaSamples::k2X);
+  if (left_samples < 0 || top_samples < 0) {
+    return;
+  }
+  int32_t tile_width = int32_t(xenos::kEdramTileWidthSamples);
+  int32_t tile_height = int32_t(xenos::kEdramTileHeightSamples);
+  int32_t column_first = (left_samples + tile_width - 1) / tile_width;
+  int32_t column_end = std::min(right_samples / tile_width, int32_t(pitch_tiles));
+  int32_t row_first = (top_samples + tile_height - 1) / tile_height;
+  int32_t row_end = bottom_samples / tile_height;
+  if (column_first >= column_end || row_first >= row_end) {
+    return;
+  }
+  for (int32_t row = row_first; row < row_end; ++row) {
+    uint32_t row_start = depth_key.base_tiles + uint32_t(row) * pitch_tiles;
+    for (int32_t column = column_first; column < column_end; ++column) {
+      stencil_may_be_nonzero_tiles_.reset((row_start + uint32_t(column)) &
+                                          (xenos::kEdramTileCount - 1));
+    }
+  }
+}
+
 void RenderTargetCache::ChangeOwnership(RenderTargetKey dest, uint32_t start_tiles_base_relative,
                                         uint32_t length_tiles,
                                         std::vector<Transfer>* transfers_append_out,
