 }
 
+bool DrawExtentEstimator::EstimateCoveredRectangle(const Shader& vertex_shader,
+                                                   int32_t& left_out, int32_t& top_out,
+                                                   int32_t& right_out, int32_t& bottom_out) {
+  const RegisterFile& regs = register_file_;
+
+  auto vgt_draw_initiator = regs.Get<reg::VGT_DRAW_INITIATOR>();
+  if (vgt_draw_initiator.prim_type != xenos::PrimitiveType::kRectangleList ||
+      vgt_draw_initiator.num_indices != 3) {
+    return false;
+  }
+  if (vgt_draw_initiator.source_select != xenos::SourceSelect::kDMA &&
+      vgt_draw_initiator.source_select != xenos::SourceSelect::kAutoIndex) {
+    return false;
+  }
+  if (xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type) &&
+      regs.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select ==
+          xenos::VGTOutputPath::kTessellationEnable) {
+    return false;
+  }
+  if (!regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable) {
+    return false;
+  }
+  auto pa_su_sc_mode_cntl = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  if (pa_su_sc_mode_cntl.cull_front || pa_su_sc_mode_cntl.cull_back ||
+      pa_su_sc_mode_cntl.poly_mode != xenos::PolygonModeEnable::kDisabled) {
+    return false;
+  }
+  assert_true(vertex_shader.type() == xenos::ShaderType::kVertex);
+  if (!vertex_shader.is_ucode_analyzed() || !ShaderInterpreter::CanInterpretShader(vertex_shader)) {
+    return false;
+  }
+
+  auto vgt_dma_size = regs.Get<reg::VGT_DMA_SIZE>();
+  const void* index_buffer = nullptr;
+  xenos::Endian index_endian = vgt_dma_size.swap_mode;
+  if (vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+    uint32_t index_buffer_base = regs[XE_GPU_REG_VGT_DMA_BASE];
+    if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16) {
+      if (index_endian == xenos::Endian::k8in32) {
+        index_endian = xenos::Endian::k8in16;
+      } else if (index_endian == xenos::Endian::k16in32) {
+        index_endian = xenos::Endian::kNone;
+      }
+      index_buffer_base &= ~uint32_t(sizeof(uint16_t) - 1);
+    } else {
+      index_buffer_base &= ~uint32_t(sizeof(uint32_t) - 1);
+    }
+    index_buffer = memory_.TranslatePhysical(index_buffer_base);
+    if (!index_buffer || vgt_dma_size.num_words < 3) {
+      return false;
+    }
+  }
+  uint32_t reset_index = regs.Get<reg::VGT_MULTI_PRIM_IB_RESET_INDX>().reset_indx;
+  uint32_t index_offset = regs.Get<reg::VGT_INDX_OFFSET>().indx_offset;
+  uint32_t min_index = regs.Get<reg::VGT_MIN_VTX_INDX>().min_indx;
+  uint32_t max_index = regs.Get<reg::VGT_MAX_VTX_INDX>().max_indx;
+
+  auto pa_cl_vte_cntl = regs.Get<reg::PA_CL_VTE_CNTL>();
+  float viewport_x_scale =
+      pa_cl_vte_cntl.vport_x_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XSCALE) : 1.0f;
+  float viewport_x_offset =
+      pa_cl_vte_cntl.vport_x_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_XOFFSET) : 0.0f;
+  float viewport_y_scale =
+      pa_cl_vte_cntl.vport_y_scale_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YSCALE) : 1.0f;
+  float viewport_y_offset =
+      pa_cl_vte_cntl.vport_y_offset_ena ? regs.Get<float>(XE_GPU_REG_PA_CL_VPORT_YOFFSET) : 0.0f;
+
+  float xs[3], ys[3];
+  shader_interpreter_.SetShader(vertex_shader);
+  PositionYExportSink export_sink;
+  shader_interpreter_.SetExportSink(&export_sink);
+  bool vertices_valid = true;
+  for (uint32_t i = 0; i < 3 && vertices_valid; ++i) {
+    uint32_t vertex_index;
+    if (vgt_draw_initiator.source_select == xenos::SourceSelect::kDMA) {
+      if (vgt_draw_initiator.index_size == xenos::IndexFormat::kInt16) {
+        vertex_index = static_cast<const uint16_t*>(index_buffer)[i];
+      } else {
+        vertex_index = static_cast<const uint32_t*>(index_buffer)[i];
+      }
+      vertex_index = xenos::GpuSwap(vertex_index, index_endian) & 0xFFFFFF;
+      if (pa_su_sc_mode_cntl.multi_prim_ib_ena && vertex_index == reset_index) {
+        vertices_valid = false;
+        break;
+      }
+    } else {
+      vertex_index = i;
+    }
+    vertex_index =
+        std::min(max_index, std::max(min_index, (vertex_index + index_offset) & 0xFFFFFF));
+    export_sink.Reset();
+    shader_interpreter_.temp_registers()[0] = float(vertex_index);
+    shader_interpreter_.Execute();
+    if ((export_sink.vertex_kill().has_value() &&
+         (export_sink.vertex_kill().value() & ~(UINT32_C(1) << 31))) ||
+        !export_sink.position_x().has_value() || !export_sink.position_y().has_value()) {
+      vertices_valid = false;
+      break;
+    }
+    float x = export_sink.position_x().value();
+    float y = export_sink.position_y().value();
+    if (!pa_cl_vte_cntl.vtx_xy_fmt) {
+      if (!export_sink.position_w().has_value() || !(export_sink.position_w().value() > 0.0f)) {
+        vertices_valid = false;
+        break;
+      }
+      x /= export_sink.position_w().value();
+      y /= export_sink.position_w().value();
+    }
+    xs[i] = x * viewport_x_scale + viewport_x_offset;
+    ys[i] = y * viewport_y_scale + viewport_y_offset;
+    if (!std::isfinite(xs[i]) || !std::isfinite(ys[i])) {
+      vertices_valid = false;
+    }
+  }
+  shader_interpreter_.SetExportSink(nullptr);
+  if (!vertices_valid) {
+    return false;
+  }
+
+  // Must be corners of an axis-aligned rectangle.
+  float min_x = std::min(xs[0], std::min(xs[1], xs[2]));
+  float max_x = std::max(xs[0], std::max(xs[1], xs[2]));
+  float min_y = std::min(ys[0], std::min(ys[1], ys[2]));
+  float max_y = std::max(ys[0], std::max(ys[1], ys[2]));
+  for (uint32_t i = 0; i < 3; ++i) {
+    if ((xs[i] != min_x && xs[i] != max_x) || (ys[i] != min_y && ys[i] != max_y)) {
+      return false;
+    }
+  }
+
+  if (regs.Get<reg::PA_SU_VTX_CNTL>().pix_center == xenos::PixelCenter::kD3DZero) {
+    min_x += 0.5f;
+    max_x += 0.5f;
+    min_y += 0.5f;
+    max_y += 0.5f;
+  }
+  auto pa_sc_window_offset = regs.Get<reg::PA_SC_WINDOW_OFFSET>();
+  if (pa_su_sc_mode_cntl.vtx_window_offset_enable) {
+    min_x += float(pa_sc_window_offset.window_x_offset);
+    max_x += float(pa_sc_window_offset.window_x_offset);
+    min_y += float(pa_sc_window_offset.window_y_offset);
+    max_y += float(pa_sc_window_offset.window_y_offset);
+  }
+  if (!(max_x - min_x < 16384.0f && max_y - min_y < 16384.0f && min_x > -16384.0f &&
+        min_y > -16384.0f && max_x < 16384.0f && max_y < 16384.0f)) {
+    return false;
+  }
+  // Pixels whose whole area is inside: all their samples are strictly inside the pixel, so they're
+  // covered whatever the edge rules (vertex snapping moves edges by far less than the distance of
+  // a sample from the pixel border).
+  int32_t left = int32_t(std::ceil(min_x));
+  int32_t top = int32_t(std::ceil(min_y));
+  int32_t right = int32_t(std::floor(max_x));
+  int32_t bottom = int32_t(std::floor(max_y));
+
+  // Window and screen scissors.
+  auto pa_sc_window_scissor_tl = regs.Get<reg::PA_SC_WINDOW_SCISSOR_TL>();
+  auto pa_sc_window_scissor_br = regs.Get<reg::PA_SC_WINDOW_SCISSOR_BR>();
+  int32_t scissor_left = int32_t(pa_sc_window_scissor_tl.tl_x);
+  int32_t scissor_top = int32_t(pa_sc_window_scissor_tl.tl_y);
+  int32_t scissor_right = int32_t(pa_sc_window_scissor_br.br_x);
+  int32_t scissor_bottom = int32_t(pa_sc_window_scissor_br.br_y);
+  if (!pa_sc_window_scissor_tl.window_offset_disable) {
+    scissor_left += pa_sc_window_offset.window_x_offset;
+    scissor_top += pa_sc_window_offset.window_y_offset;
+    scissor_right += pa_sc_window_offset.window_x_offset;
+    scissor_bottom += pa_sc_window_offset.window_y_offset;
+  }
+  uint32_t screen_scissor_tl = regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_TL];
+  uint32_t screen_scissor_br = regs[XE_GPU_REG_PA_SC_SCREEN_SCISSOR_BR];
+  scissor_left = std::max(scissor_left, int32_t(screen_scissor_tl & 0x7FFF));
+  scissor_top = std::max(scissor_top, int32_t((screen_scissor_tl >> 16) & 0x7FFF));
+  scissor_right = std::min(scissor_right, int32_t(screen_scissor_br & 0x7FFF));
+  scissor_bottom = std::min(scissor_bottom, int32_t((screen_scissor_br >> 16) & 0x7FFF));
+  left = std::max(left, scissor_left);
+  top = std::max(top, scissor_top);
+  right = std::min(right, scissor_right);
+  bottom = std::min(bottom, scissor_bottom);
+  if (left >= right || top >= bottom) {
+    return false;
+  }
+  left_out = left;
+  top_out = top;
+  right_out = right;
+  bottom_out = bottom;
+  return true;
+}
