+bool D3D12CommandProcessor::AllocateDeferredReadback(uint32_t size, uint32_t& offset_out) {
+  for (uint32_t attempt = 0; attempt < 2; ++attempt) {
+    // The oldest readback still in flight; allocations complete in order.
+    uint32_t tail = UINT32_MAX;
+    for (const DeferredGuestWrite& entry : deferred_guest_writes_) {
+      if (entry.readback_length) {
+        tail = entry.readback_buffer_offset;
+        break;
+      }
+    }
+    if (tail == UINT32_MAX) {
+      deferred_readback_head_ = 0;
+      if (size <= deferred_readback_buffer_size_) {
+        offset_out = 0;
+        deferred_readback_head_ = size;
+        return true;
+      }
+    } else if (deferred_readback_head_ > tail) {
+      // Free: [head, end) and [0, tail).
+      if (deferred_readback_head_ + size <= deferred_readback_buffer_size_) {
+        offset_out = deferred_readback_head_;
+        deferred_readback_head_ += size;
+        return true;
+      }
+      if (size < tail) {
+        offset_out = 0;
+        deferred_readback_head_ = size;
+        return true;
+      }
+    } else if (deferred_readback_head_ + size < tail) {
+      // Free: [head, tail), strictly less so the head never reaches the tail.
+      offset_out = deferred_readback_head_;
+      deferred_readback_head_ += size;
+      return true;
+    }
+    if (attempt) {
+      break;
+    }
+    // Full or too small: complete everything in flight, then grow if needed.
+    ApplyDeferredGuestWrites(true);
+    if (size > deferred_readback_buffer_size_) {
+      // Every copy into the old buffer has been awaited.
+      if (deferred_readback_buffer_) {
+        deferred_readback_buffer_->Unmap(0, nullptr);
+        deferred_readback_buffer_->Release();
+        deferred_readback_buffer_ = nullptr;
+        deferred_readback_mapping_ = nullptr;
+        deferred_readback_buffer_size_ = 0;
+      }
+      uint32_t new_size = rex::align(std::max(size, uint32_t(64 * 1024 * 1024)),
+                                     kReadbackBufferSizeIncrement);
+      const ui::d3d12::D3D12Provider& provider = GetD3D12Provider();
+      D3D12_RESOURCE_DESC buffer_desc;
+      ui::d3d12::util::FillBufferResourceDesc(buffer_desc, new_size, D3D12_RESOURCE_FLAG_NONE);
+      ID3D12Resource* buffer = nullptr;
+      if (FAILED(provider.GetDevice()->CreateCommittedResource(
+              &ui::d3d12::util::kHeapPropertiesReadback, provider.GetHeapFlagCreateNotZeroed(),
+              &buffer_desc, D3D12_RESOURCE_STATE_COPY_DEST, nullptr, IID_PPV_ARGS(&buffer)))) {
+        REXGPU_ERROR("Failed to create a {} MB deferred resolve readback buffer", new_size >> 20);
+        return false;
+      }
+      D3D12_RANGE read_range = {0, new_size};
+      void* mapping = nullptr;
+      if (FAILED(buffer->Map(0, &read_range, &mapping))) {
+        REXGPU_ERROR("Failed to map the deferred resolve readback buffer");
+        buffer->Release();
+        return false;
+      }
+      deferred_readback_buffer_ = buffer;
+      deferred_readback_mapping_ = mapping;
+      deferred_readback_buffer_size_ = new_size;
+    }
+  }
+  return false;
+}
+
+void D3D12CommandProcessor::ApplyDeferredGuestWrites(bool await_gpu) {
+  if (deferred_guest_writes_.empty()) {
+    return;
+  }
+  uint64_t completed;
+  bool gpu_completed = true;
+  if (await_gpu) {
+    gpu_completed = AwaitAllQueueOperationsCompletion();
+    completed = UINT64_MAX;
+  } else {
+    completed = submission_fence_->GetCompletedValue();
+  }
+  RegisterFile& regs = *register_file_;
+  while (!deferred_guest_writes_.empty()) {
+    // A copy: an interrupt runs guest code.
+    const DeferredGuestWrite entry = deferred_guest_writes_.front();
+    if (entry.readback_length) {
+      if (entry.submission > completed) {
+        break;
+      }
+      uint8_t* destination = memory_->TranslatePhysical(entry.readback_guest_address);
+      if (gpu_completed && deferred_readback_mapping_ && destination) {
+        std::memcpy(destination,
+                    static_cast<const uint8_t*>(deferred_readback_mapping_) +
+                        entry.readback_buffer_offset,
+                    entry.readback_length);
+      }
+      --deferred_readback_count_;
+    } else {
+      if (entry.write.register_index != kGuestVisibleWriteNoRegister) {
+        const_cast<volatile uint32_t&>(regs.values[entry.write.register_index]) =
+            entry.write.register_value;
+      }
+      if (entry.write.has_memory) {
+        memory::store(memory_->TranslatePhysical(entry.write.memory_address),
+                      entry.write.memory_value);
+      }
+    }
+    deferred_guest_writes_.pop_front();
+    if (entry.write.interrupt_cpu_mask && graphics_system_) {
+      for (uint32_t n = 0; n < 6; ++n) {
+        if (entry.write.interrupt_cpu_mask & (uint32_t(1) << n)) {
+          graphics_system_->DispatchInterruptCallback(1, n);
+        }
+      }
+    }
+  }
+  if (!deferred_readback_count_) {
+    deferred_readback_head_ = 0;
+  }
+}
+
+bool D3D12CommandProcessor::PollGuestVisibleWrites() {
+  if (deferred_guest_writes_.empty()) {
+    return false;
+  }
+  // If a readback is still in the open submission (ending it wasn't possible right after the
+  // copy), submit it so the GPU gets to it.
+  if (submission_open_ && CanEndSubmissionImmediately()) {
+    for (const DeferredGuestWrite& entry : deferred_guest_writes_) {
+      if (entry.readback_length && entry.submission >= submission_current_) {
+        EndSubmission(false);
+        break;
+      }
+    }
+  }
+  ApplyDeferredGuestWrites(false);
+  return !deferred_guest_writes_.empty();
+}
+
+bool D3D12CommandProcessor::PeekQueuedGuestRegister(uint32_t index, uint32_t& value) const {
+  for (auto it = deferred_guest_writes_.crbegin(); it != deferred_guest_writes_.crend(); ++it) {
+    if (!it->readback_length && it->write.register_index == index) {
+      value = it->write.register_value;
+      return true;
+    }
+  }
+  return false;
+}
+
+bool D3D12CommandProcessor::PeekQueuedGuestMemory32(uint32_t physical_address,
+                                                    uint32_t& value) const {
+  for (auto it = deferred_guest_writes_.crbegin(); it != deferred_guest_writes_.crend(); ++it) {
+    if (it->readback_length) {
+      // A queued resolve covering the word changes it too: let the caller wait for it.
+      if (physical_address >= it->readback_guest_address &&
+          physical_address - it->readback_guest_address < it->readback_length) {
+        return false;
+      }
+    } else if (it->write.has_memory && it->write.memory_address == physical_address) {
+      value = it->write.memory_value;
+      return true;
+    }
+  }
+  return false;
+}
+
+bool D3D12CommandProcessor::QueueGuestVisibleWrite(const GuestVisibleWrite& write) {
+  if (deferred_guest_writes_.empty()) {
+    return false;
+  }
+  deferred_guest_writes_.push_back({0, 0, 0, 0, write});
+  return true;
+}
+
