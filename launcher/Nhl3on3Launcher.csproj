<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NHL 3on3 Launcher</AssemblyName>
    <RootNamespace>Nhl3on3Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>launcher.ico</ApplicationIcon>
    <Version>0.1.0-prealpha.3</Version>
    <Product>3 on 3 NHL Arcade PC port</Product>
    <Description>Builds and starts the 3 on 3 NHL Arcade PC port from your own copy of the game</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="launcher.ico" />
  </ItemGroup>

</Project>
