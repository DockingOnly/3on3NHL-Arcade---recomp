<Window x:Class="Nhl3on3Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3 on 3 NHL Arcade" Width="800" Height="640"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#070C18" FontFamily="{StaticResource UiFont}" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar"/>
    </Window.TaskbarItemInfo>

    <Grid>
        <!-- Background: arena at night, with faint rink markings -->
        <Grid IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{StaticResource BgTopColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource BgBottomColor}" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Ellipse Width="760" Height="520" Margin="0,-260,-260,0" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#302A8BFF" Offset="0"/>
                        <GradientStop Color="#002A8BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="600" Height="420" Margin="-280,0,0,-220" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1CE63946" Offset="0"/>
                        <GradientStop Color="#00E63946" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Canvas>
                <Ellipse Canvas.Left="560" Canvas.Top="380" Width="360" Height="360" Stroke="#0FFFFFFF" StrokeThickness="3"/>
                <Ellipse Canvas.Left="732" Canvas.Top="552" Width="16" Height="16" Fill="#14E63946"/>
                <Rectangle Canvas.Left="-40" Canvas.Top="0" Width="3" Height="700" Fill="#10E63946">
                    <Rectangle.RenderTransform><RotateTransform Angle="0"/></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="120" Canvas.Top="0" Width="2" Height="700" Fill="#0C4DB8FF"/>
            </Canvas>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Margin="20,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Puck logo -->
                    <Grid Width="28" Height="22" Margin="0,2,10,0">
                        <Ellipse Height="10" VerticalAlignment="Bottom" Fill="#05080F"/>
                        <Rectangle Height="8" Margin="0,0,0,5" VerticalAlignment="Bottom" Fill="#05080F"/>
                        <Ellipse Height="10" VerticalAlignment="Top" Margin="0,4,0,0">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3A4A66" Offset="0"/>
                                    <GradientStop Color="#141C2C" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Height="10" VerticalAlignment="Top" Margin="0,4,0,0" Stroke="#4DB8FF" StrokeThickness="1" Opacity="0.7"/>
                    </Grid>
                    <TextBlock Text="3 on 3 NHL Arcade" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Margin="10,0,0,0" Padding="7,2" CornerRadius="6" Background="#1FE63946" BorderBrush="#66E63946" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="PC PORT" FontSize="10" FontWeight="Bold" Foreground="#FF8A94"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="11" Foreground="{StaticResource DimBrush}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="Minimize_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Step indicator -->
            <StackPanel Grid.Row="1" x:Name="Steps" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,6"/>

            <!-- ============ SETUP ============ -->
            <Grid Grid.Row="2" x:Name="SetupPanel" Margin="44,14,44,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Heading}" Text="Let's set up your game"/>
                <TextBlock Grid.Row="1" Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,18" LineHeight="20">
                    Point the launcher at your own copy of 3 on 3 NHL Arcade. It builds the PC version from it,
                    right here on this PC. Nothing is uploaded.
                </TextBlock>

                <!-- Drop zone / chosen game -->
                <Grid Grid.Row="2" x:Name="DropZone" AllowDrop="True" MinHeight="186" Background="Transparent"
                      DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                    <Rectangle x:Name="DropBorder" RadiusX="16" RadiusY="16" Stroke="#3A5583" StrokeThickness="1.5"
                               StrokeDashArray="5 4" Fill="#0CFFFFFF"/>

                    <StackPanel x:Name="DropEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <Border Width="52" Height="52" CornerRadius="26" Background="#1A4DB8FF" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="22" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock Text="Drop your game here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock Style="{StaticResource Muted}" TextAlignment="Center" FontSize="12.5" MaxWidth="460">
                            The 58410975 folder, the package file inside 58410975\000D0000, or an already unpacked copy.
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                            <Button Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Browse for file" Click="BrowseFile_Click" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Browse for file"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Choose folder" Click="BrowseFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Choose folder"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="DropBusy" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ContentControl x:Name="DropSpinnerHost" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="DropBusyText" Text="Checking your copy…" Style="{StaticResource Muted}" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Grid x:Name="DropChosen" Margin="22" Visibility="Collapsed" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="84" Height="84" CornerRadius="14" ClipToBounds="True" Background="#16243F" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" FontSize="30" Foreground="{StaticResource AccentBrush}"/>
                                <Image x:Name="GameThumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip><RectangleGeometry Rect="0,0,84,84" RadiusX="14" RadiusY="14"/></Image.Clip>
                                </Image>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,12,0" VerticalAlignment="Center">
                            <TextBlock x:Name="GameName" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="GamePath" Style="{StaticResource Muted}" FontSize="12" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,10"/>
                            <WrapPanel>
                                <Border x:Name="GameBadge" CornerRadius="8" Padding="9,4" Margin="0,0,8,4" Background="#1A3DDC97" BorderBrush="#553DDC97" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="GameBadgeIcon" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="GameBadgeText" Text="Verified" FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border CornerRadius="8" Padding="9,4" Margin="0,0,8,4" Background="#12FFFFFF">
                                    <TextBlock x:Name="GameSize" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Change" VerticalAlignment="Center" Click="ChangeGame_Click"/>
                    </Grid>
                </Grid>

                <!-- Problem with the chosen copy -->
                <Border Grid.Row="3" x:Name="SetupError" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,10" CornerRadius="10"
                        Background="#1AFF6B7A" BorderBrush="#55FF6B7A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource ErrorBrush}" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="SetupErrorText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SetupErrorHint" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Build tools status -->
                <Border Grid.Row="4" x:Name="ToolsCard" VerticalAlignment="Top" Margin="0,14,0,0" Padding="14,11" CornerRadius="12"
                        Background="#0DFFFFFF" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="ToolsIconHost" Width="20" VerticalAlignment="Top" Margin="0,1,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ToolsTitle" Text="Looking for build tools…" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ToolsDetail" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="5" Margin="0,16,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5">
                            <Run Text="&#xE823;" FontFamily="{StaticResource IconFont}"/>
                            <Run Text=" One-time build, about 5–30 minutes depending on your PC."/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,0" Text="You can keep using your PC while it runs."/>
                    </StackPanel>
                    <Button x:Name="BuildButton" AutomationProperties.Name="Build game" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" IsEnabled="False" Click="Build_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Build game" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="13" Margin="10,1,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- ============ BUILD ============ -->
            <Grid Grid.Row="2" x:Name="BuildPanel" Margin="44,14,44,30" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="BuildHeading" Style="{StaticResource Heading}" Text="Building your game"/>
                    <TextBlock x:Name="BuildPercent" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontFamily="{StaticResource DisplayFont}"
                               FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                </Grid>
                <TextBlock Grid.Row="1" x:Name="BuildSubtitle" Style="{StaticResource Muted}" FontSize="14" Margin="0,6,0,14"/>

                <ProgressBar Grid.Row="2" x:Name="OverallBar" Style="{StaticResource SlimProgress}" Margin="0,0,0,16"/>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,10">
                    <StackPanel x:Name="StageList"/>
                </Border>

                <!-- Failure / details -->
                <Grid Grid.Row="4" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="BuildError" Visibility="Collapsed" Margin="0,0,0,10" Padding="14,10" CornerRadius="10"
                            Background="#1AFF6B7A" BorderBrush="#55FF6B7A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BuildErrorIcon" Style="{StaticResource Icon}" Text="&#xE783;" Foreground="{StaticResource ErrorBrush}" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="BuildErrorText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BuildErrorHint" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBox Grid.Row="1" x:Name="LogBox" Style="{StaticResource LogBox}" Visibility="Collapsed" MinHeight="80"/>
                </Grid>

                <Grid Grid.Row="5" Margin="0,14,0,0">
                    <Button x:Name="DetailsButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Details_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailsChevron" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="0,1,8,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="DetailsText" Text="Show details" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="OpenLogButton" Style="{StaticResource SecondaryButton}" Content="Open log" Margin="0,0,10,0" Visibility="Collapsed" Click="OpenLog_Click"/>
                        <Button x:Name="BackButton" Style="{StaticResource SecondaryButton}" Content="Back" Margin="0,0,10,0" Visibility="Collapsed" Click="Back_Click"/>
                        <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" Click="Cancel_Click"/>
                        <Button x:Name="RetryButton" AutomationProperties.Name="Try again" Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="Retry_Click" Padding="22,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,1,9,0" Foreground="White"/>
                                <TextBlock Text="Try again" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ READY ============ -->
            <Grid Grid.Row="2" x:Name="ReadyPanel" Margin="44,10,44,26" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="BannerFrame" CornerRadius="16" ClipToBounds="True" HorizontalAlignment="Center"
                        BorderBrush="#33FFFFFF" BorderThickness="1" Background="#101A2E">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.55" Color="Black"/></Border.Effect>
                    <Grid>
                        <Image x:Name="Banner" Stretch="Uniform" Width="615" Height="143" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip><RectangleGeometry Rect="0,0,615,143" RadiusX="15" RadiusY="15"/></Image.Clip>
                        </Image>
                        <TextBlock x:Name="BannerFallback" Text="3 on 3 NHL Arcade" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,22,0,0">
                    <TextBlock Style="{StaticResource Heading}" Text="Ready to play" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ReadyDetail" Style="{StaticResource Muted}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Row="2" x:Name="UpdateNotice" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,14,0,0"
                        Padding="14,9" CornerRadius="10" Background="#1A4DB8FF" BorderBrush="#554DB8FF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/>
                        <TextBlock x:Name="UpdateNoticeText" VerticalAlignment="Center" FontSize="13"/>
                        <Button Style="{StaticResource LinkButton}" Content="Update now" Margin="12,0,0,0" VerticalAlignment="Center" Click="Rebuild_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button x:Name="PlayButton" AutomationProperties.Name="Play" Style="{StaticResource PrimaryButton}" Width="280" Height="64" Click="Play_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="20" Foreground="White" Margin="0,2,14,0"/>
                            <TextBlock Text="PLAY" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="{StaticResource DisplayFont}"/>
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="CloseOnPlay" Style="{StaticResource Switch}" Content="Close the launcher when the game starts"
                              HorizontalAlignment="Center" Margin="0,18,0,0" Checked="CloseOnPlay_Changed" Unchecked="CloseOnPlay_Changed"/>
                    <TextBlock x:Name="PlayError" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource LinkButton}" Click="OpenFolder_Click" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="13" Margin="0,1,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Game folder" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Click="Settings_Click" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="13" Margin="0,1,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Settings file" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Click="Rebuild_Click" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="13" Margin="0,1,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Rebuild" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource LinkButton}" Click="AnotherCopy_Click" Margin="10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" FontSize="13" Margin="0,1,7,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Use another copy" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- In-window dialog -->
        <Grid x:Name="DialogOverlay" Visibility="Collapsed" Background="#B3050A14">
            <Border Style="{StaticResource Card}" Background="#14203A" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="Black"/></Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DialogIcon" Style="{StaticResource Icon}" FontSize="20" Margin="0,0,12,0" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="DialogTitle" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock x:Name="DialogBody" Style="{StaticResource Muted}" FontSize="13.5" LineHeight="20" Margin="0,12,0,0"/>
                    <Button x:Name="DialogLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="DialogLink_Click" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="DialogSecondary" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="DialogSecondary_Click"/>
                        <Button x:Name="DialogPrimary" AutomationProperties.Name="Dialog OK" Style="{StaticResource PrimaryButton}" Padding="22,10" FontSize="14" Click="DialogPrimary_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
